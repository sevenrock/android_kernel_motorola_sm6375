config TOUCHSCREEN_ILI_9882_MMI
	tristate "Ilitek Touchscreen Driver 9882 MMI"
	default n
	help
	  Say Y here if you wish to include support for Ilitek Touchscreen Driver 9882 MMI.

	  If unsure, say N.

	  To compile this driver as a module, choose M here: the
	  module will be called ili9882_mmi.

config TOUCHSCREEN_ILI_9882_MMI_ENABLE_DOUBLE_TAP
	bool "Ilitek Touchscreen Driver 9882 MMI Double tap"
	depends on TOUCHSCREEN_ILI_9882_MMI
	depends on SENSORS_CLASS
	default n
	help
	  Say Y here if you want to have double tap support on Ilitek 9882 MMI.

	  If unsure, say N.

